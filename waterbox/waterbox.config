   "display": "setting.drive_true_emulation",
   "type": "enum",
   "options": [
    "enabled",
    "disabled"
   ],
   "default": "enabled",
   "description": "setting.drive_true_emulation.about"
  },
  {
   "name": "autostart",
   "display": "setting.autostart",
   "type": "enum",
   "options": [
    "enabled",
    "disabled"
   ],
   "default": "enabled",
   "description": "setting.autostart.about"
  },
  {
   "name": "p1Port",
   "display": "setting.p1port",
   "type": "enum",
   "options": [
    "2",
    "1"
   ],
   "default": "2",
   "description": "setting.p1port.about"
  },
  {
   "name": "initialTime",
   "display": "setting.initialtime",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 946684800,
   "description": "setting.initialtime.about"
  }
 ],
 "firmware": [],
 "_firmware_note": "None to supply: VICE carries the C64's and the 1541's ROMs (Commodore's), and the core is built with them.",
 "_controls_note": "P1 is the joystick in control port 2 (or port 1, with P1 Port), P2 the joystick in the other. Previous Disk and Next Disk move a selector over the project's files; Eject Disk takes the disk out of drive 8 while it is held and puts the selected one in when it is let go. Tape Play, Stop, Rewind and Forward are the datasette's keys. The keys are the C64's own, by what is printed on them (C= is the Commodore key): the 64 of its keyboard matrix and RESTORE. SHIFT LOCK latches Left Shift down; hold Left Shift instead.",
