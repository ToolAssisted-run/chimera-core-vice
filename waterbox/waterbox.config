{
 "coreName": "VICE",
 "systemNames": {
  "C64": "Commodore 64"
 },
 "author": "The VICE team and the vice-libretro authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-vice",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  256,
  8,
  16,
  64,
  256
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. A C64 has 64 KB; every file the core opens (a disk is 170 KB, a tape some MB) is held whole in memory, where the C64 writes to it.",
 "video": {
  "_comment": "The BUFFER CAPACITY. VICE's picture is 384x272 for a PAL machine and 384x247 for an NTSC one, borders included; the live size comes from GetVideoWidth/Height.",
  "width": 1024,
  "height": 640,
  "vsyncNumerator": 50125,
  "vsyncDenominator": 1000,
  "_vsync_note": "A PAL C64 makes 50.125 frames a second (985,248 cycles a second, 19,656 a frame), an NTSC one 59.826; the live rate comes from GetVsyncNumerator/Denominator.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "VICE's mix (reSID) at 48 kHz, stereo.",
  "rate": 48000,
  "samplesPerFrame": 4096,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "c64_model",
   "display": "Model",
   "type": "enum",
   "options": [
    "C64 PAL auto",
    "C64 NTSC auto",
    "C64C PAL auto",
    "C64C NTSC auto",
    "C64 PAL",
    "C64 NTSC",
    "C64C PAL",
    "C64C NTSC",
    "C64SX PAL",
    "C64SX NTSC",
    "PET64 PAL",
    "PET64 NTSC",
    "C64 GS PAL",
    "C64 JAP NTSC"
   ],
   "default": "C64 PAL auto",
   "description": "Which C64, as VICE builds it: the original C64, the C64C (its later board, with the 8580 SID), the SX-64, the PET64, the C64 Games System, the Japanese C64; PAL (Europe) or NTSC (America, Japan). The 'auto' ones are PAL or NTSC as the game's file name says ('NTSC' in it makes an NTSC machine). It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "sid_model",
   "display": "SID Model",
   "type": "enum",
   "options": [
    "default",
    "6581",
    "8580",
    "8580RD"
   ],
   "default": "default",
   "description": "The sound chip: 'default' is the Model's own (the 6581 in the C64, the 8580 in the C64C); 8580RD is an 8580 with the digi boost. It changes the sound and what a program reads from the SID. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "drive_true_emulation",
   "display": "True Drive Emulation",
   "type": "enum",
   "options": [
    "enabled",
    "disabled"
   ],
   "default": "enabled",
   "description": "'enabled' runs the 1541 drive's own processor and its DOS, cycle by cycle, as the hardware does: fast loaders and copy protections work. 'disabled' answers the C64's disk commands directly, much faster, and many games do not load. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "autostart",
   "display": "Autostart",
   "type": "enum",
   "options": [
    "enabled",
    "disabled"
   ],
   "default": "enabled",
   "description": "'enabled' loads and runs the game when the C64 is switched on, as VICE does it: it types LOAD and RUN for a disk or a tape (pressing the tape's PLAY), or puts a program straight in memory. 'disabled' leaves the C64 at its READY prompt with the game's disk in the drive or tape in the datasette. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "p1Port",
   "display": "P1 Port",
   "type": "enum",
   "options": [
    "2",
    "1"
   ],
   "default": "2",
   "description": "Which control port P1's joystick is in; P2's is in the other. Most games read the joystick in port 2. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "initialTime",
   "display": "Starting Clock",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 946684800,
   "description": "What the computer's clock says when the C64 is switched on, in seconds since 1970 (Unix time); it then runs with the machine. VICE takes its random numbers from it (the pattern the RAM holds when it is switched on, and the wait before autostart), and so does the clock of a cartridge that has one. The default is the first of January 2000. This is a setting, and not your computer's clock, so that a movie plays back the same on any day. It is part of the machine, so a movie needs the same value."
  }
 ],
 "firmware": [],
 "_firmware_note": "None to supply: VICE carries the C64's and the 1541's ROMs (Commodore's), and the core is built with them.",
 "_controls_note": "P1 is the joystick in control port 2 (or port 1, with P1 Port), P2 the joystick in the other. Previous Disk and Next Disk move a selector over the project's files; Eject Disk takes the disk out of drive 8 while it is held and puts the selected one in when it is let go. Tape Play, Stop, Rewind and Forward are the datasette's keys. The keys are the C64's own, by what is printed on them (C= is the Commodore key): the 64 of its keyboard matrix and RESTORE. SHIFT LOCK latches Left Shift down; hold Left Shift instead.",
