   "description": "setting.c64_model.about"
  },
  {
   "name": "sid_model",
   "display": "setting.sid_model",
   "type": "enum",
   "options": [
    "default",
    "6581",
    "8580",
    "8580RD"
   ],
   "default": "default",
   "description": "setting.sid_model.about"
  },
  {
