{
 "coreName": "VICE",
 "systemNames": {
  "C64": "Commodore 64"
 },
 "author": "The VICE team and the vice-libretro authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-vice",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  256,
  8,
  16,
  64,
  256
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. A C64 has 64 KB; every file the core opens (a disk is 170 KB, a tape some MB) is held whole in memory, where the C64 writes to it.",
 "video": {
  "_comment": "The BUFFER CAPACITY. VICE's picture is 384x272 for a PAL machine and 384x247 for an NTSC one, borders included; the live size comes from GetVideoWidth/Height.",
  "width": 1024,
  "height": 640,
  "vsyncNumerator": 50125,
  "vsyncDenominator": 1000,
  "_vsync_note": "A PAL C64 makes 50.125 frames a second (985,248 cycles a second, 19,656 a frame), an NTSC one 59.826; the live rate comes from GetVsyncNumerator/Denominator.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "VICE's mix (reSID) at 48 kHz, stereo.",
  "rate": 48000,
  "samplesPerFrame": 4096,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "c64_model",
   "display": "setting.c64_model",
   "type": "enum",
   "options": [
    "C64 PAL auto",
    "C64 NTSC auto",
    "C64C PAL auto",
    "C64C NTSC auto",
    "C64 PAL",
    "C64 NTSC",
