  vd / 'vice/src/c64',
  vd / 'vice/src/c64/cart',
  vd / 'vice/src/core',
  vd / 'vice/src/datasette',
  vd / 'vice/src/diag',
  vd / 'vice/src/drive',
  vd / 'vice/src/drive/iec',
  vd / 'vice/src/drive/iec/c64exp',
  vd / 'vice/src/drive/ieee',
  vd / 'vice/src/drive/tcbm',
  vd / 'vice/src/fsdevice',
  vd / 'vice/src/imagecontents',
  vd / 'vice/src/joyport',
  vd / 'vice/src/lib/p64',
