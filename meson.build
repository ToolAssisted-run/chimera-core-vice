  vd / 'vice/src/residfp',
  vd / 'vice/src/residfp/builders/residfp-builder/residfp',
  vd / 'vice/src/rs232drv',
  vd / 'vice/src/samplerdrv',
  vd / 'vice/src/tape',
  vd / 'vice/src/tapeport',
