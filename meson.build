# musl's math functions in both builds (waterbox/libm/README)
libm_names = ['sin.c', 'cos.c', 'sinf.c', 'exp.c', 'log.c', 'pow.c', '__sin.c', '__cos.c',
  '__rem_pio2.c', '__rem_pio2_large.c', '__sindf.c', '__cosdf.c', '__rem_pio2f.c',
  'exp_data.c', 'log_data.c', 'pow_data.c', '__math_oflow.c', '__math_uflow.c', '__math_xflow.c',
  '__math_invalid.c', '__math_divzero.c']
libm_sources = []
foreach n : libm_names
  libm_sources += 'waterbox/libm' / n
endforeach
chimera_libm = static_library('chimera-libm', files(libm_sources),
  c_args: ['-Dhidden=__attribute__((__visibility__("hidden")))', '-fno-builtin'],
  include_directories: include_directories('waterbox/libm'))

