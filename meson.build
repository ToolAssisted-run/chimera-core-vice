# chimera-core-vice: VICE, the Commodore 64 emulator, through its libretro
# port (vice-libretro), in miniBox's sandbox, as a Chimera core.
#
# Native reference build (run-native + run-wbx under the build directory):
#     meson setup build/meson-native -Dminibox_dir=<miniBox> && ninja -C build/meson-native
# Guest (core.wbx) build via the cross file waterbox/setup-guest.sh writes:
#     sh waterbox/setup-guest.sh -m <miniBox> && ninja -C build/meson-guest core.wbx
#
# The file list is upstream's own for x64sc, VICE's cycle-exact C64: what
# "make EMUTYPE=x64sc platform=unix" compiles (Makefile, Makefile.common,
# Makefile.x64sc). The emulator is driven by waterbox/cinterface.c through
# upstream's libretro entry points. Both flavours compile the SAME sources;
# only emulibc.h differs (waterbox/native-shim for the reference).
project('chimera-core-vice', ['c', 'cpp'],
  default_options: ['c_std=gnu99', 'cpp_std=gnu++11', 'optimization=2', 'debug=false', 'warning_level=0'])

vd = 'extern/vice'

# the submodule pin is upstream as it is; the patches are laid over it
# (waterbox/apply-patches.sh does nothing to a tree that has them)
run_command(files('waterbox/apply-patches.sh'), check: true)

mb = get_option('minibox_dir')
if mb == ''
  mb_candidate = meson.current_source_dir() / '../chimera/extern/chimera-common-minibox'
  if import('fs').is_dir(mb_candidate)
    mb = mb_candidate
  else
    error('pass -Dminibox_dir=<miniBox checkout> (or keep one at ../chimera/extern/chimera-common-minibox)')
  endif
endif

# upstream's own defines (Makefile), and what the patches test for
defs = [
  '-D__LIBRETRO__', '-DHAVE_CONFIG_H', '-DUSE_LIBRETRO_VFS', '-DHAVE_7ZIP', '-D_7ZIP_ST', '-DNDEBUG',
  '-DCORE_NAME="x64sc"', '-D__X64SC__', '-DGIT_VERSION=""',
  '-DCHIMERA_CORE',
  # strcasestr, which the guest's C library declares only for GNU sources
  '-D_GNU_SOURCE',
]
# signed overflow wraps; one answer from a floating-point expression on
# every machine: no fused multiply-adds; a local read before it is written
# is zero in every build
flags = [
  '-fwrapv',
  '-fno-strict-aliasing',
  '-ffp-contract=off',
  '-ftrivial-auto-var-init=zero',
  # the same file from any checkout on any day: VICE prints the build's date
  # and time when it starts, and file names reach the binary
  '-Wno-builtin-macro-redefined', '-D__DATE__="Oct  3 2026"', '-D__TIME__="02:28:37"',
  '-ffile-prefix-map=' + meson.current_source_dir() + '=.',
  '-ffile-prefix-map=' + meson.current_build_dir() + '=build',
]
add_project_arguments(defs + flags, language: ['c', 'cpp'])

inc = include_directories(
  'waterbox',
  vd / 'vice/src',
  vd,
  vd / 'libretro',
  vd / 'include',
  vd / 'include/embedded',
  vd / 'vice/src/core/rtc',
  vd / 'vice/src/lib',
